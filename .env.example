# 邮件奖励隔离测试使用的变量名。把真实值放在未提交的本地配置里。
# 不要指向正式集群，不要在这里写数据库密码或 LUNASERVER_MAIL_DELIVER_TOKEN。
LUNASERVER_FORMAL=
LUNASERVER_ADVERTISE_HOST=
LUNASERVER_RUN_DIR=
# Login admission is per gateway process. 0 rejects new Login/Reconnect.
LUNASERVER_LOGIN_INFLIGHT_MAX=256
LUNASERVER_LOGIN_RECONNECT_RESERVE=32
LUNASERVER_LOGIN_AUTH_INFLIGHT=256
LUNASERVER_LOGIN_SESSION_INFLIGHT=256
LUNASERVER_LOGIN_BIND_INFLIGHT=256
LUNASERVER_LOGIN_ENTER_INFLIGHT=256
# Stress stays on an isolated loopback cluster. Do not put a public EIP here.
LUNASERVER_STRESS_ALLOW_LARGE=
LUNASERVER_STRESS_ALLOW_REMOTE=
